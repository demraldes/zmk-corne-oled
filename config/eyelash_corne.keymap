#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

&mt {
    tapping-term-ms = <155>;
    flavor = "tap-unless-interrupted";
};

&sk { quick-release; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        Forward-Slash {
            bindings = <&kp SLASH>;
            key-positions = <38 39>;
            timeout-ms = <33>;
        };

        Esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            timeout-ms = <33>;
        };

        Bspc {
            bindings = <&kp BACKSPACE>;
            key-positions = <24 25>;
            timeout-ms = <33>;
        };

        Bspc2 {
            bindings = <&kp BACKSPACE>;
            key-positions = <24 23>;
            timeout-ms = <33>;
        };

        Question {
            bindings = <&kp QUESTION>;
            key-positions = <38 39 40>;
            timeout-ms = <33>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB           &kp Q         &kp W  &kp E      &kp R  &kp T                          &kp UP                &kp Y  &kp U        &kp I        &kp O    &kp P            &kp BSPC
&kp LEFT_CONTROL  &kp A         &kp S  &kp D      &kp F  &kp G                &kp LEFT  &kp ENTER  &kp RIGHT  &kp H  &kp J        &kp K        &kp L    &kp APOSTROPHE   &kp SEMI
&kp LEFT_SHIFT    &mt LSHIFT Z  &kp X  &kp C      &kp V  &kp B  &kp C_MUTE              &kp DOWN              &kp N  &kp M        &kp COMMA    &kp DOT  &kp RIGHT_SHIFT  &kp RIGHT_SHIFT
                                       &lt 3 TAB  &mo 1  &none                                                &none  &lt 2 SPACE  &lt 3 ENTER
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&trans  &kp GRAVE       &none      &none     &none     &kp BSLH                        &trans          &kp SEMI  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &trans
&trans  &kp N1          &kp N2     &kp N3    &kp N4    &kp N5                  &trans  &trans  &trans  &kp N6    &kp N7     &kp N8     &kp N9    &kp N0    &trans
&trans  &sk LEFT_SHIFT  &sk LCTRL  &sk LALT  &sk LGUI  &kp ESC   &kp C_MUTE            &trans          &kp ESC   &sk RGUI   &kp COMMA  &kp DOT   &kp FSLH  &trans
                                   &trans    &trans    &trans                                          &trans    &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp TILDE        &none        &none     &none       &kp PIPE                       &trans          &kp COLON  &kp UNDER  &kp PLUS   &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT            &trans  &trans  &trans  &kp CARET  &kp AMPS   &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &sk LSHFT        &sk LCTRL    &sk LALT  &sk LGUI    &kp ESC      &trans            &trans          &kp ESC    &sk RGUI   &sk RALT   &sk RCTRL             &sk RSHFT              &trans
                                      &trans    &trans      &trans                                         &trans     &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            display-name = "Fn";
            bindings = <
&trans  &none      &none      &none     &none     &none                      &trans          &none    &sk F11   &sk F12   &none      &kp DEL    &trans
&trans  &sk F1     &sk F2     &sk F3    &sk F4    &sk F5             &trans  &trans  &trans  &sk F6   &sk F7    &sk F8    &sk F9     &sk F10    &trans
&trans  &sk LSHFT  &sk LCTRL  &sk LALT  &sk LGUI  &kp ESC  &trans            &trans          &kp ESC  &sk RGUI  &sk RALT  &sk RCTRL  &sk RSHFT  &trans
                              &trans    &trans    &trans                                     &trans   &trans    &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };
    };
};
