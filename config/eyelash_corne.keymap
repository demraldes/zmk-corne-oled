#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <1000>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

&mt {
    tapping-term-ms = <155>;
    flavor = "balanced";
};

&sk { quick-release; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;

            label = "shift-caps";
        };

        td1: td1 {
            compatible = "zmk,behavior-tap-dance";
            label = "sticky_lgui-lgui";
            #binding-cells = <0>;
            bindings = <&sk LEFT_WIN>, <&kp LEFT_WIN>;

            tapping-term-ms = <200>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <30>;
    };

    combos {
        compatible = "zmk,combos";

        Forward-Slash {
            bindings = <&kp SLASH>;
            key-positions = <38 39>;
            timeout-ms = <33>;
        };

        Esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
            timeout-ms = <33>;
        };

        Bspc {
            bindings = <&kp BACKSPACE>;
            key-positions = <24 25>;
            timeout-ms = <33>;
        };

        Bspc2 {
            bindings = <&kp BACKSPACE>;
            key-positions = <24 23>;
            timeout-ms = <33>;
        };

        Question {
            bindings = <&kp QUESTION>;
            key-positions = <38 39 40>;
            timeout-ms = <33>;
        };
    };

    macros {
        windows_screensaver: windows_screensaver {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCMD &kp R>,
                <&macro_release>,
                <&kp LCMD &kp R>,
                <&macro_wait_time 50>,
                <&macro_tap>,
                <&kp LS(C) &kp COLON &kp BSLH &kp LS(S) &kp DOT &kp L &kp N &kp K>,
                <&macro_wait_time 100>,
                <&kp ENTER>;

            label = "WINDOWS_SCREENSAVER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp ESC        &kp Q         &kp W  &kp E      &kp R  &kp T                                 &kp UP                &kp Y           &kp U        &kp I        &kp O    &kp P            &kp BSPC
&kp PAGE_UP    &kp A         &kp S  &kp D      &kp F  &kp G                       &kp LEFT  &kp ENTER  &kp RIGHT  &kp H           &kp J        &kp K        &kp L    &kp APOSTROPHE   &kp SEMI
&kp PAGE_DOWN  &mt LSHIFT Z  &kp X  &kp C      &kp V  &kp B         &kp C_MUTE              &kp DOWN              &kp N           &kp M        &kp COMMA    &kp DOT  &kp RIGHT_SHIFT  &mo 4
                                    &lt 3 TAB  &mo 1  &msc SCRL_UP                                                &msc SCRL_DOWN  &lt 2 SPACE  &lt 3 ENTER
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&trans  &kp GRAVE       &none      &none     &none   &kp BSLH                                &mmv MOVE_UP                     &kp SEMI  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &trans
&trans  &kp N1          &kp N2     &kp N3    &kp N4  &kp N5                  &mmv MOVE_LEFT  &mkp MB1        &mmv MOVE_RIGHT  &kp N6    &kp N7     &kp N8     &kp N9    &kp N0    &trans
&trans  &sk LEFT_SHIFT  &sk LCTRL  &sk LALT  &td1    &kp ESC   &kp C_MUTE                    &mmv MOVE_DOWN                   &kp ESC   &sk RGUI   &kp COMMA  &kp DOT   &kp FSLH  &trans
                                   &trans    &trans  &trans                                                                   &trans    &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp TILDE        &none        &none     &none       &kp PIPE                       &trans          &kp COLON  &kp UNDER  &kp PLUS   &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT            &trans  &trans  &trans  &kp CARET  &kp AMPS   &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &sk LSHFT        &sk LCTRL    &sk LALT  &sk LGUI    &kp ESC      &trans            &trans          &kp ESC    &sk RGUI   &sk RALT   &sk RCTRL             &sk RSHFT              &trans
                                      &trans    &trans      &trans                                         &trans     &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            display-name = "Fn";
            bindings = <
&trans  &none      &none      &none     &none     &none                      &trans          &none    &sk F11   &sk F12   &windows_screensaver  &kp DEL    &trans
&trans  &sk F1     &sk F2     &sk F3    &sk F4    &sk F5             &trans  &trans  &trans  &sk F6   &sk F7    &sk F8    &sk F9                &sk F10    &trans
&trans  &sk LSHFT  &sk LCTRL  &sk LALT  &sk LGUI  &kp ESC  &trans            &trans          &kp ESC  &sk RGUI  &sk RALT  &sk RCTRL             &sk RSHFT  &trans
                              &trans    &trans    &trans                                     &trans   &trans    &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_4 {
            display-name = "SYS";
            bindings = <
&bt BT_CLR  &trans        &trans        &trans        &trans        &trans                                               &rgb_ug RGB_SAI                   &trans           &trans  &trans  &soft_off  &trans  &trans
&trans      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                        &rgb_ug RGB_HUD  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &trans           &trans  &trans  &trans     &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans           &rgb_ug RGB_TOG                     &rgb_ug RGB_SAD                   &trans           &trans  &trans  &trans     &trans  &trans
                                        &trans        &trans        &rgb_ug RGB_SPI                                                                        &rgb_ug RGB_SPD  &trans  &trans
            >;

            sensor-bindings = <&rgb_encoder>;
        };
    };
};
